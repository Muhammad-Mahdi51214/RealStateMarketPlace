{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./frontend/*"],
      "@backend/*": ["./backend/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "backend/src/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["node_modules", "frontend/.next"]
}
