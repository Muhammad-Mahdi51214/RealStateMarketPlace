# App (public — safe for browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional — app uses in-memory demo store if unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SERVER ONLY (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_x-pRezS2ukMZew3ec2oXrg_h8NiuDkU

# JWT auth (HS256). Required in production. Tokens expire after 2 hours.
AUTH_JWT_SECRET=change-me-to-a-long-random-secret

# Payments — default KuickPay PSID flow
# sandbox | kuickpay | jazzcash | easypaisa | payfast
PAYMENT_GATEWAY_PROVIDER=kuickpay
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_SANDBOX_FORCE_FAIL=false

# KuickPay live credentials (server-only). Leave blank for demo PSID mode.
KUICKPAY_USERNAME=
KUICKPAY_PASSWORD=
KUICKPAY_INSTITUTION_ID=
KUICKPAY_PREFIX=71090
